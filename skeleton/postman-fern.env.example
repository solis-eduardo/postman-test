# Config única lida pelos scripts em scripts/ e pelos workflows em .github/workflows/.
# Copie pra "postman-fern.env" na raiz do projeto (fora deste skeleton/) e
# preencha com os valores reais do seu projeto. Não precisa editar nenhum
# script nem workflow -- todos leem daqui.
#
# IMPORTANTE: este arquivo é lido tanto por `source` do bash quanto por um
# parser Python simples -- por isso TODO valor que tiver espaço precisa
# estar entre aspas duplas (ex.: COLLECTION_NAME="Minha API"), senão o
# `source` do bash quebra tentando interpretar as palavras extras como
# comando (testado: sem aspas, dá erro "comando não encontrado" na palavra
# depois do espaço). Valores sem espaço não precisam de aspas, mas usar
# sempre não faz mal.
#
# Uso local:
#   bash: `set -a; source postman-fern.env; set +a` (já feito por scripts/lint.sh etc.)
#   python: os.environ é populado automaticamente pelos scripts .py deste kit
#
# Uso no CI: os workflows em .github/workflows/*.yml já fazem
# `source postman-fern.env` como primeiro passo -- não precisa repetir os
# valores como secret/variable do GitHub, exceto FERN_TOKEN (esse sim é
# secret, configurado separadamente -- ver docs/SETUP.md).

# Nome exibido da collection no Postman -- vira o nome da pasta em
# postman/collections/<COLLECTION_NAME>/ e o nome do arquivo em dist/.
COLLECTION_NAME="Minha API"

# Slug (sem espaços/acentos) usado na pasta do mock: postman/mocks/<MOCK_SLUG>/
MOCK_SLUG="minha-api"

# Versão da API usada no path das requisições (bate com o {{api_version}}
# usado dentro da collection, se você usar esse padrão).
API_VERSION="v1"

# Organização/slug da Fern (o mesmo valor de fern/fern.config.json).
# Descubra com: npx fern-api login && npx fern-api org get
FERN_ORG="sua-org-fern"

# Domínio publicado da Fern (o mesmo valor de fern/docs.yml, instances[].url
# -- SEM https://, ver docs/fern-docs.md sobre esse bug específico).
FERN_DOMAIN="sua-org.docs.buildwithfern.com"

# owner/repo do GitHub (usado nos exemplos de import-por-link e nos
# comandos `gh` da documentação).
GITHUB_REPO="sua-org/seu-repo"
