  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script global de pré-requisição da collection.",
          "// Garante que exista um access_token antes de qualquer chamada autenticada,",
          "// exceto para as próprias rotas de autenticação.",
          "const isAuthRequest = pm.request.url.toString().includes('/auth/');",
          "const token = pm.environment.get('access_token');",
          "",
          "if (!isAuthRequest && !token) {",
          "    console.warn('[PetVerse API] Nenhum access_token encontrado. Execute a requisição \"Login\" da pasta Auth antes de chamar endpoints protegidos.');",
          "}",
          "",
          "pm.request.headers.add({ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
