{
  "info": {
    "name": "PetVerse API",
    "description": "API fictícia de uma clínica veterinária / petshop. Gerencia tutores (owners), pets, consultas (appointments) e autenticação. Usada como coleção de exemplo para demonstrar o padrão Git Native do Postman (schema de collection v3, YAML por request).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "path": [
                "{{api_version}}",
                "auth",
                "login"
              ],
              "host": [
                "{{base_url}}"
              ],
              "query": [],
              "variable": []
            },
            "description": "Autentica um usuário e retorna access_token/refresh_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retorna 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta contém access_token e refresh_token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json).to.have.property('refresh_token');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('access_token', json.access_token);",
                  "    pm.environment.set('refresh_token', json.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 - Login bem-sucedido",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "path": [
                    "v1",
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{base_url}}"
                  ],
                  "query": [],
                  "variable": []
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiJ9.mock.token\",\n  \"refresh_token\": \"9f2c9a3e-6e2a-4e9b-9a3e-6e2a4e9b9a3e\",\n  \"expires_in\": 3600\n}"
            },
            {
              "name": "401 - Credenciais inválidas",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "path": [
                    "v1",
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{base_url}}"
                  ],
                  "query": [],
                  "variable": []
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"invalid_credentials\",\n  \"message\": \"E-mail ou senha inválidos.\"\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "path": [
                "{{api_version}}",
                "auth",
                "refresh"
              ],
              "host": [
                "{{base_url}}"
              ],
              "query": [],
              "variable": []
            },
            "description": "Renova o access_token a partir de um refresh_token válido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh retorna 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('access_token', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "path": [
                "{{api_version}}",
                "auth",
                "logout"
              ],
              "host": [
                "{{base_url}}"
              ],
              "query": [],
              "variable": []
            },
            "description": "Invalida o refresh_token atual."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout retorna 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.environment.unset('access_token');",
                  "pm.environment.unset('refresh_token');"
                ]
              }
            }
          ]
        }
      ],
      "description": "Autenticação e ciclo de vida do token de acesso."
    },
