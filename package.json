{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "postman-test",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Aplicação Laravel (PetVerse API) + collection fictícia versionada no padrão Git Native do Postman (collection schema v3), com spec OpenAPI, ambientes, testes e scripts de apoio.",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "bash scripts/lint.sh",
        "test": "bash scripts/run-collection.sh Local cli",
        "test:staging": "bash scripts/run-collection.sh Staging cli",
        "export:v2": "python3 scripts/export_v2_collection.py && node scripts/normalize_v2_collection.js \"dist/PetVerse API.postman_collection.json\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postman-cli": "^1.45.0",
        "postman-collection": "^5.3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
